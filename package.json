{
  "name": "kemono-pawchive-archive-ripper",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "Local-first Discord and Patreon/Fanbox post archiver for Kemono and Pawchive",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build.mjs",
