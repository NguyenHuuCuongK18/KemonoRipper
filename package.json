{
  "name": "kemono-pawchive-archive-ripper",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local-first Discord and Patreon/Fanbox post archiver for Kemono and Pawchive",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build.mjs",
    "check": "npm run test && npm run build",
    "test:browser": "node scripts/browser-test.mjs",
    "test:acceptance": "node scripts/media-acceptance.mjs",
    "test:selection": "node scripts/selection-acceptance.mjs",
    "test:tolerance": "node scripts/tolerance-acceptance.mjs",
    "test:settings": "node scripts/settings-acceptance.mjs",
    "recon": "node scripts/recon.mjs",
    "package": "node scripts/package.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:check": "npm run check && npm run test:browser && npm run test:acceptance && npm run test:selection && npm run test:tolerance && npm run test:settings && npm run package && npm run release:verify"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.23.0",
    "libarchive-wasm": "1.2.0"
  }
}
